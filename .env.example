DSM_HOST=nas.example.com
DSM_PORT=5001
DSM_HTTPS=true
# Eigener DSM-User nur für den MCP, nie das Hauptkonto
DSM_USER=mcp
DSM_PASSWORD=
# true | false | Pfad zu CA-Datei
DSM_VERIFY_SSL=true
# optional: Zertifikatsname, wenn DSM_HOST eine interne IP ist (z.B. nas.example.com)
DSM_TLS_SERVERNAME=
# optional: SHA-256 des DSM-Zertifikats (Pinning statt CA-Prüfung, Wert aus tls_check)
DSM_TLS_FINGERPRINT=
# true = cms_dsm_update darf mit confirm=true DSM-Updates verteilen (sonst nur Vorschau)
MCP_ALLOW_WRITE=false
# Ordner mit .pat-Dateien auf der CMS-NAS (DSM_<Modell>_<Build>.pat)
CMS_PATCH_DIR=
# langes zufälliges Bearer-Token für den MCP-Endpoint (mind. 32 Zeichen)
MCP_AUTH_TOKEN=
# Schwellwerte für health_report
MCP_VOLUME_WARN_PERCENT=85
MCP_DISK_TEMP_WARN=55
MCP_DISK_LIFE_WARN_PERCENT=20
# optional: Host-Interface für das Port-Mapping (Standard localhost; LAN-IP für Reverse-Proxy auf anderem Host)
MCP_BIND_ADDR=127.0.0.1
MCP_HOST_PORT=8432
